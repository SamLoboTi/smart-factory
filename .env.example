# ============================================
# SMART FACTORY - CONFIGURACAO SEGURA
# ============================================

# Banco principal de telemetria industrial.
DATABASE_PATH=data/smart_factory.db

# Banco separado para configuracoes sensiveis de notificacao.
# O telefone do destinatario e salvo criptografado em repouso.
NOTIFICATION_DATABASE_PATH=secure-data/notification_config.db
NOTIFICATION_ENCRYPTION_KEY=troque-esta-chave-por-uma-chave-forte

# ===== TWILIO / WHATSAPP =====
# Obtenha suas credenciais em: https://www.twilio.com/console
# Nunca exponha esses valores no Vite, React ou repositorio.
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here

# Numero WhatsApp do Twilio, sandbox ou numero proprio.
# Sandbox Twilio: whatsapp:+14155238886
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# O destinatario e configurado na tela do sistema:
# /notificacoes

# ===== ALERTAS =====
PRE_ALERT_THRESHOLD=0.60
CRITICAL_THRESHOLD=0.80
TEMP_WARNING_PERCENT=0.85
VIB_WARNING_PERCENT=0.85
ALERT_COOLDOWN_MINUTES=15

# ===== CORS / TUNNEL =====
# Use lista explicita. Evite wildcard em producao.
CORS_ALLOWED_ORIGINS=http://localhost:5174
CORS_TUNNEL_ORIGINS=

# ===== VITE DEV SERVER =====
# O Vite aceita localhost por padrao. Habilite tunnel apenas quando necessario.
VITE_ENABLE_TUNNEL=false
VITE_ALLOWED_HOSTS=

# ============================================
# USO
# ============================================
# 1. Copie este arquivo para .env.
# 2. Configure Twilio e NOTIFICATION_ENCRYPTION_KEY.
# 3. Suba o sistema.
# 4. Acesse /notificacoes e cadastre o responsavel.
# 5. Use "Enviar teste" para validar o WhatsApp.
